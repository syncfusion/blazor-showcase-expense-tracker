@inject NavigationManager Urihelper
@* SEO Variables - Single source of truth for all meta tags *@
@{
    string SeoTitle = "Expense Tracker - Syncfusion Blazor Showcase";
    string SeoDescription = "Track and manage expenses with real-world Syncfusion Blazor components integrated into one application.";
    string SiteUrl = Urihelper.Uri.TrimEnd('/');
    string ApplicationName = "Expense Tracker";
    string Publisher = "Syncfusion";
    string Language = "English";
    string SocialImage = SiteUrl + "/ExpenseTracker.svg";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <!-- Google Tag Manager -->
    <!-- Load GTM-P3WXFWCW immediately on page load  -->
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                    'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-WXZ6DX9B');
    </script>
    <!-- Load GTM-W8WD8WN on user interaction -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const events = ["mousemove", "scroll", "keydown", "touchstart"];
            function loadGTM() {
                events.forEach(event => document.removeEventListener(event, loadGTM));
                (function (w, d, s, l, i) {
                    w[l] = w[l] || []; w[l].push({
                        'gtm.start':
                            new Date().getTime(), event: 'gtm.js'
                    }); var f = d.getElementsByTagName(s)[0],
                        j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                            'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
                })(window, document, 'script', 'dataLayer', 'GTM-W8WD8WN');
            }
            events.forEach(event => document.addEventListener(event, loadGTM, { once: true }));
        });
    </script>
    <title>@SeoTitle</title>
    
    <!-- Primary Meta Tags -->
    <meta name="title" content="@SeoTitle" />
    <meta name="description" content="@SeoDescription" />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="expense tracker, financial management, Blazor, budgeting, tracking" />
    <meta name="publisher" content="@Publisher" />
    <meta name="language" content="@Language" />
    
    <!-- Canonical URL -->
    <link href="https://showcase.syncfusion.com/expense-tracker/blazor/" rel="canonical" />
    
    <!-- Alternate Language Tags -->
    <link rel="alternate" hreflang="en-US" href="@SiteUrl" />
    <link rel="alternate" hreflang="x-default" href="@SiteUrl" />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@SeoTitle" />
    <meta property="og:description" content="@SeoDescription" />
    <meta property="og:url" content="@SiteUrl" />
    <meta property="og:site_name" content="@ApplicationName" />
    <meta property="og:image" content="@SocialImage" />
    <meta property="og:image:alt" content="@ApplicationName Logo" />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@SeoTitle" />
    <meta name="twitter:description" content="@SeoDescription" />
    <meta name="twitter:image" content="@SocialImage" />
    <meta name="twitter:image:alt" content="@ApplicationName" />
    <meta name="twitter:site" content="@@Syncfusion" />
    
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <ResourcePreloader />
    <link rel="shortcut icon" href="favicon.ico" />
    <link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Raleway:500,600" rel="stylesheet">
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <base href="/" />
    <link href="@Assets["styles/message.css"]" rel="stylesheet" />
    <link href="@Assets["styles/skeleton.css"]" rel="stylesheet" />
    <link href="@Assets["styles/styles.css"]" rel="stylesheet" />
    <link href="@Assets["styles/index.css"]" rel="stylesheet" />
    <link href="@Assets["styles/main.css"]" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Roboto+Condensed|Roboto" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.20/lodash.min.js"></script>
    <script type="text/javascript">
        if (/MSIE \d|Trident.*rv:/.test(navigator.userAgent)) {
            document.write('<script src="SFResource/blazor.polyfill.min.js"><\/script>');
        }
    </script>
        <script type="application/ld+json">
    {
      "@@context": "https://schema.org/",
      "@@type": "SoftwareApplication",
      "name": "@ApplicationName",
      "description": "@SeoDescription",
      "url": "@SiteUrl",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "browserRequirements": "WebAssembly enabled browser",
      "image": "@SocialImage",
      "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "author": {
        "@@type": "Organization",
        "name": "@Publisher",
        "url": "https://www.syncfusion.com"
      },
      "inLanguage": "en-US"
    }
    </script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <!-- Google Tag Manager (noscript) -->
    <!--Page Load-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WXZ6DX9B" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!--Interaction-->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W8WD8WN" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div hidden id="sync-analytics" data-queue="Syncfusion - Showcase - Blazor - ExpenseTracker"></div>
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/Syncfusion.Blazor.Core/scripts/syncfusion-blazor.min.js"]" type="text/javascript"></script>
</body>

</html>
