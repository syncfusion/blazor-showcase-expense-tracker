<div class="modern-cards-container">
    <div class="stat-card income">
        <div class="stat-card-header">
            <h3 class="stat-card-title">Total Income</h3>
            <div class="stat-card-icon income">💰</div>
        </div>
        <div class="stat-card-value" id="tolincome">@TotalIncome</div>
    </div>

    <div class="stat-card expense">
        <div class="stat-card-header">
            <h3 class="stat-card-title">Total Expenses</h3>
            <div class="stat-card-icon expense">💳</div>
        </div>
        <div class="stat-card-value" id="tolexpense">@TotalExpense</div>
    </div>

    <div class="stat-card balance">
        <div class="stat-card-header">
            <h3 class="stat-card-title">Balance</h3>
            <div class="stat-card-icon balance">📊</div>
        </div>
        <div class="stat-card-value" id="tolbalance">@TotalBalance</div>
    </div>

    <div class="stat-card transactions">
        <div class="stat-card-header">
            <h3 class="stat-card-title">Total Transactions</h3>
            <div class="stat-card-icon" style="background: rgba(243, 156, 18, 0.1); color: #F39C12;">📝</div>
        </div>
        <div class="stat-card-value" id="toltransaction">@TotalTransactions</div>
    </div>
</div>

@code{
    [CascadingParameter]
    private ExpenseDataService ExpenseDataService { get; set; } = default!;
    [Parameter]
    public IEnumerable<ExpenseData>? IncomeData { get; set; }
    [Parameter]
    public IEnumerable<ExpenseData>? ExpenseData { get; set; }

    private string TotalIncome = "$0";
    private string TotalExpense = "$0";
    private string TotalBalance = "$0";
    private string TotalTransactions = "0";
    
    private string IncomeTrend = "vs last month";
    private string ExpenseTrend = "vs last month";
    private decimal PreviousIncomeAmount = 0;
    private decimal PreviousExpenseAmount = 0;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        UpdateCards();
    }

    /// <summary>
    /// Calculation for card values
    /// </summary>
    public void RefreshCards(IEnumerable<ExpenseData> incomeData, IEnumerable<ExpenseData> expenseData)
    {
        IncomeData = incomeData; ExpenseData = expenseData;
        UpdateCards();
    }
    
    private void UpdateCards()
    {
        var incomeRS = 0;
        var expenseRS = 0;
        
        // Calculate current period totals
        incomeRS = (IncomeData ?? Enumerable.Empty<ExpenseData>()).Sum(s => s.Amount);
        expenseRS = (ExpenseData ?? Enumerable.Empty<ExpenseData>()).Sum(s => s.Amount);
        
        TotalIncome = CommonService.GetCurrencyVal(incomeRS);
        TotalExpense = CommonService.GetCurrencyVal(expenseRS);
        TotalBalance = CommonService.GetCurrencyVal(incomeRS - expenseRS);
        TotalTransactions = CommonService.GetNumberVal((ExpenseDataService.CurrentExpenseData ?? Enumerable.Empty<ExpenseData>()).Count());
        
        // Calculate trend indicators comparing to previous month
        IncomeTrend = CalculateTrend(incomeRS, PreviousIncomeAmount, "Income");
        ExpenseTrend = CalculateTrend(expenseRS, PreviousExpenseAmount, "Expense");
        
        PreviousIncomeAmount = incomeRS;
        PreviousExpenseAmount = expenseRS;
        
        ExpenseDataService.UpdateCurrentBalance(TotalBalance);
    }
    
    private string CalculateTrend(int currentAmount, decimal previousAmount, string type)
    {
        if (previousAmount == 0)
            return "vs last month";
            
        decimal percentChange = ((currentAmount - (int)previousAmount) / (int)previousAmount) * 100;
        
        if (percentChange > 5)
            return $"↑ {Math.Abs(percentChange):F1}% vs last month";
        else if (percentChange < -5)
            return $"↓ {Math.Abs(percentChange):F1}% vs last month";
        else
            return "→ Same as last month";
    }
    
    private string GetTrendClass(string trend)
    {
        if (trend.Contains("↑"))
            return "positive";
        else if (trend.Contains("↓"))
            return "negative";
        else
            return "neutral";
    }
}