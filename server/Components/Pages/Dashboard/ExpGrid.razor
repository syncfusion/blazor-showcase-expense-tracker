<div class="recent-transactions-card">
    <div class="recent-transactions-header">
        <h3 class="recent-transactions-title">Recent Transactions</h3>
        <div class="transaction-controls">
            <div class="transaction-search">
                <input type="text" placeholder="Search by category..." 
                       @oninput="OnSearchInput" 
                       aria-label="Search transactions" />
            </div>
            <select class="filter-button" @onchange="OnFilterChange" aria-label="Filter by transaction type">
                <option value="">All Types</option>
                <option value="Expense">Expenses</option>
                <option value="Income">Income</option>
            </select>
        </div>
    </div>
    
    <div class="row recent-expense-grid">
        <div class="col-xs-6 col-sm-6 col-md-12" style="width:100%">
            @if (FilteredTransactions != null && FilteredTransactions.Any())
            {
                <SfGrid TValue="ExpenseData" DataSource="@FilteredTransactions" Height="100%" AllowSorting="true" 
                        EnableHover="false" AllowPaging="true" Width="100%">
                    <GridPageSettings PageCount="4" PageSize="8"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(ExpenseData.DateTime)" HeaderText="Date" Width="22%" Format="d" ClipMode="@ClipMode.EllipsisWithTooltip"></GridColumn>
                        <GridColumn Field="@nameof(ExpenseData.Category)" HeaderText="Category" Width="32%" ClipMode="@ClipMode.EllipsisWithTooltip">
                            <Template>
                                @{
                                    var expense = (context as ExpenseData);
                                    <div class="transaction-row">
                                        <div class="transaction-icon">
                                            <div class="category-icon @expense?.Category" style="margin: 0; width: 24px; height: 24px;"></div>
                                        </div>
                                        <div class="transaction-details">
                                            <div class="transaction-category" title="@expense?.Category">@expense?.Category</div>
                                            <div class="transaction-description" title="@expense?.Description">@expense?.Description</div>
                                        </div>
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ExpenseData.PaymentMode)" HeaderText="Payment Mode" Width="26%" ClipMode="@ClipMode.EllipsisWithTooltip"></GridColumn>
                        <GridColumn Field="@nameof(ExpenseData.Amount)" HeaderText="Amount" Width="20%" TextAlign="@TextAlign.Right" ClipMode="@ClipMode.EllipsisWithTooltip">
                            <Template>
                                @{
                                    var expense = (context as ExpenseData);
                                    <div class="transaction-amount @expense?.TransactionType">
                                        @if (expense?.TransactionType == "Income")
                                        {
                                            <span>+</span>
                                        }
                                        <span>$@expense?.Amount</span>
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            }
            else
            {
                <div style="padding: 40px; text-align: center; color: #7F8C8D;">
                    <p>No transactions found matching your search.</p>
                </div>
            }
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public IEnumerable<ExpenseData>? RecentExpenseData { get; set; }
    
    private List<ExpenseData> FilteredTransactions = new();
    private string SearchTerm = "";
    private string FilterType = "";
    
    protected override void OnParametersSet()
    {
        ApplyFilters();
    }
    
    private void OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        SearchTerm = (e.Value?.ToString() ?? "").ToLower();
        ApplyFilters();
    }
    
    private void OnFilterChange(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        FilterType = e.Value?.ToString() ?? "";
        ApplyFilters();
    }
    
    private void ApplyFilters()
    {
        if (RecentExpenseData == null)
        {
            FilteredTransactions = new List<ExpenseData>();
            return;
        }
        
        var filtered = RecentExpenseData.AsEnumerable();
        
        // Apply transaction type filter
        if (!string.IsNullOrEmpty(FilterType))
        {
            filtered = filtered.Where(x => x.TransactionType == FilterType);
        }
        
        // Apply search filter
        if (!string.IsNullOrEmpty(SearchTerm))
        {
            filtered = filtered.Where(x => 
                (x.Category?.ToLower().Contains(SearchTerm) ?? false) ||
                (x.Description?.ToLower().Contains(SearchTerm) ?? false) ||
                (x.PaymentMode?.ToLower().Contains(SearchTerm) ?? false) ||
                (x.UniqueId?.ToLower().Contains(SearchTerm) ?? false)
            );
        }
        
        FilteredTransactions = filtered.ToList();
    }
}