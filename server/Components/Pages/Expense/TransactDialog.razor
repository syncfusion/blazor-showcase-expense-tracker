@implements IDisposable;
@using Syncfusion.Blazor.Popups;
@inject SfDialogService DialogService;

<div id='dlg-content'>
    <Syncfusion.Blazor.Popups.SfDialogProvider />
    <div id="dialogTarget">
        <SfMessage Severity="MessageSeverity.Success" Visible=@ShowDeleteMsg>The transaction(s) has been deleted successfully.</SfMessage>
        <SfMessage Severity="MessageSeverity.Success" Visible=@ShowAddedMsg>The transaction has been added successfully.</SfMessage>
        <SfMessage Severity="MessageSeverity.Success" Visible=@ShowSavedMsg>The transaction has been saved successfully.</SfMessage>
        @if (CreateNewDialog)
        {
            <SfDialog @ref="TransactionDialog" Width="500px" Height="auto" CssClass="modern-transact-dialog" ShowCloseIcon="true" CloseOnEscape="false" IsModal="true" AllowDragging="true">
                <ChildContent>
                    <DialogTemplates>
                        <Header>@DialogHeader</Header>
                    </DialogTemplates>
                    <div class='modern-dlg-content'>
                        <div class="modern-transaction-dialog">
                            <input type='hidden' id="uniqueId" @bind="UniqueId" class="e-input required readonly" />
                            
                            <!-- Transaction Type Section -->
                            <div class='form-section transaction-type-section'>
                                <label class="section-label">Transaction Type</label>
                                <div class='transaction-type-buttons'>
                                    <SfRadioButton TChecked="string" Label="Income" @bind-Checked="TransactionType" Value="Income" Name='dlgTransactionType' ValueChange="DlgTransactTypeChanged" CssClass="type-radio"></SfRadioButton>
                                    <SfRadioButton TChecked="string" Label="Expense" @bind-Checked="TransactionType" Value="Expense" Name='dlgTransactionType' ValueChange="DlgTransactTypeChanged" CssClass="type-radio"></SfRadioButton>
                                </div>
                            </div>

                            <!-- Date & Time Section -->
                            <div class='form-section datetime-section'>
                                <label class="section-label">When</label>
                                <div class='datetime-fields'>
                                    <div class='field-wrapper date-wrapper'>
                                        <SfDatePicker Placeholder='Choose a Date' Width='100%' FloatLabelType='FloatLabelType.Always' @bind-Value="DateValue" Min="@MinDate" Max="@MaxDate"></SfDatePicker>
                                    </div>
                                    <div class='field-wrapper time-wrapper'>
                                        <SfTimePicker Placeholder='Choose a Time' Width='100%' FloatLabelType='FloatLabelType.Always' @bind-Value="TimeValue"></SfTimePicker>
                                    </div>
                                </div>
                            </div>

                            <!-- Category & Amount Section -->
                            <div class='form-section category-amount-section'>
                                <label class="section-label">Details</label>
                                <div class='category-amount-fields'>
                                    <div class='field-wrapper category-wrapper'>
                                        <SfDropDownList @ref="DropDownList" TValue="string" CssClass='Category' Placeholder='Select a Category' FloatLabelType='FloatLabelType.Always'
                                                        TItem="CategoryData" DataSource='CategoryDataSource' @bind-Value="CategoryValue">
                                            <DropDownListFieldSettings Text="Category" Value="Category" IconCss="Class"></DropDownListFieldSettings>
                                        </SfDropDownList>
                                    </div>
                                    <div class='field-wrapper amount-wrapper'>
                                        <SfNumericTextBox TValue="double?" Placeholder='Enter a Amount' FloatLabelType='FloatLabelType.Always' Format="c2" Min="0" @bind-Value="Amount"></SfNumericTextBox>
                                    </div>
                                </div>
                            </div>

                            <!-- Description Section -->
                            <div class='form-section description-section'>
                                <label class="section-label">Description</label>
                                <div class="field-wrapper">
                                    <div class="e-float-input">
                                        <input type='text' @bind="Description" class="e-input" />
                                        <span class="e-float-line"></span>
                                        <label class="e-float-text e-label-top">Add notes (optional)</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Payment Mode Section -->
                            <div class='form-section payment-section'>
                                <label class="section-label">Payment Method</label>
                                <div class='payment-options'>
                                    <SfRadioButton Label="Cash" Value="Cash" @bind-Checked="PaymentMode" Name='dlgPaymentMode' CssClass="payment-radio"></SfRadioButton>
                                    <SfRadioButton Label="Debit Card" Value="Debit Card" @bind-Checked="PaymentMode" Name='dlgPaymentMode' CssClass="payment-radio"></SfRadioButton>
                                    <SfRadioButton Label="Credit Card" Value="Credit Card" @bind-Checked="PaymentMode" Name='dlgPaymentMode' CssClass="payment-radio"></SfRadioButton>
                                </div>
                            </div>
                        </div>
                    </div>
                    <DialogButtons>
                        <DialogButton Content="@ButtonContent" CssClass="e-info e-add" IsPrimary="true" OnClick="OnClickSave" />
                        <DialogButton Content="Cancel" CssClass="e-outline e-cancel" OnClick="OnClickCancel" />
                    </DialogButtons>
                    <DialogEvents Created="OnCreate"></DialogEvents>
                </ChildContent>
            </SfDialog>
        }
    </div>
</div>

@code{
    public SfDialog? TransactionDialog;
    public TransactGrid ContentRef { get; set; } = default!;
    SfDropDownList<string, CategoryData>? DropDownList;

    public string? CategoryValue { get; set; } = null;
    public DateTime? DateValue;
    public DateTime? TimeValue;
    public string UniqueId { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public double? Amount = 0;
    public List<CategoryData> CategoryDataSource { get; set; } = new();
    [CascadingParameter]
    public ExpenseDataService ExpenseDataService { get; set; } = default!;
    [Parameter]
    public Action<List<ExpenseData>>? OnGridUpdate { get; set; }
    public bool IsAdd = false;

    private DateTime MinDate;
    private DateTime MaxDate;
    private ExpenseData? SelectedRecord;
    private string ButtonContent = "Add";

    public string DialogHeader { get; set; } = string.Empty;
    public bool CreateNewDialog = false;
    public bool ShowAddedMsg;
    public bool ShowDeleteMsg;
    public bool ShowSavedMsg;
    public string TransactionType = "Expense";

    public string PaymentMode = "Cash";

    List<ExpenseData> GridSelectedRecords { get; set; } = new();
    private bool ShouldShowDialog = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        this.DialogHeader = "";
        this.Description = "";
        this.MinDate = new DateTime(2019, 06, 01, 00, 00, 00);
        this.MaxDate = new DateTime(2019, 11, 30, 23, 59, 59);
        
        if (ExpenseDataService != null)
        {
            this.DateValue = ExpenseDataService.EndDate;
            this.CategoryDataSource = ExpenseDataService.CategoryExpenseData ?? new List<CategoryData>();
        }
        else
        {
            this.DateValue = DateTime.Now;
            this.CategoryDataSource = new List<CategoryData>();
        }
        
        this.GridSelectedRecords = new List<ExpenseData>();
    }
    
    protected override async Task OnParametersSetAsync()
    {
        // This is called after CascadingParameters are set
        await base.OnParametersSetAsync();
        
        if (ExpenseDataService != null && (CategoryDataSource == null || CategoryDataSource.Count == 0))
        {
            this.CategoryDataSource = ExpenseDataService.CategoryExpenseData ?? new List<CategoryData>();
        }
    }

    /// <summary>
    /// Show Add Dialog
    /// </summary>
    public async Task ShowAddDialog()
    {
        this.IsAdd = true;
        this.UpdateAddDialog();
        
        if (this.TransactionDialog == null)
        {
            ShouldShowDialog = true;
            CreateNewDialog = true;
            StateHasChanged();
        }
        else
        {
            await this.TransactionDialog.ShowAsync();
        }
    }

    private void UpdateAddDialog()
    {
        this.DialogHeader = "New Transaction";
        this.ButtonContent = "Add";
        this.UniqueId = "T" + DateTime.Now.Ticks.ToString().Substring(12, 6);
        this.Amount = 0;
        this.DateValue = this.TimeValue = (ExpenseDataService != null) ? ExpenseDataService.EndDate : DateTime.Now;
        this.Description = "";
        this.TransactionType = "Expense";
        this.PaymentMode = "Cash";
        
        if (ExpenseDataService != null)
        {
            this.CategoryDataSource = ExpenseDataService.CategoryExpenseData ?? new List<CategoryData>();
        }
        else
        {
            this.CategoryDataSource = this.CategoryDataSource ?? new List<CategoryData>();
        }
        
        this.CategoryValue = (this.CategoryDataSource != null && this.CategoryDataSource.Count > 0) ? CategoryDataSource[0].Category : "";
    }

    /// <summary>
    /// Show edit dialog
    /// </summary>
    /// <param name="selectedRecord"></param>
    public async Task ShowEditDialog(ExpenseData selectedRecord)
    {
        this.IsAdd = false;
        SelectedRecord = selectedRecord;
        this.UpdateEditDialog();
        
        if (this.TransactionDialog == null)
        {
            ShouldShowDialog = true;
            CreateNewDialog = true;
            StateHasChanged();
        }
        else
        {
            await this.TransactionDialog.ShowAsync();
        }
    }

    private void UpdateEditDialog()
    {
        this.DialogHeader = "Edit Transaction";
        this.ButtonContent = "Save";
        if (SelectedRecord != null && ExpenseDataService != null)
        {
            this.UniqueId = SelectedRecord.UniqueId ?? "";
            if (SelectedRecord.TransactionType == "Income")
            {
                this.TransactionType = "Income";
                this.CategoryDataSource = this.ExpenseDataService.CategoryIncomeData ?? new List<CategoryData>();
            }
            else if (SelectedRecord.TransactionType == "Expense")
            {
                this.TransactionType = "Expense";
                this.CategoryDataSource = this.ExpenseDataService.CategoryExpenseData ?? new List<CategoryData>();
            }
            this.DateValue = this.TimeValue = SelectedRecord.DateTime;
            this.PaymentMode = SelectedRecord.PaymentMode ?? "";
            this.Description = SelectedRecord.Description ?? "";
            this.Amount = (double?)SelectedRecord.Amount;
            this.CategoryValue = SelectedRecord.Category;
        }
    }

    public void OnCreate()
    {
        if (IsAdd)
            this.UpdateAddDialog();
        else
            this.UpdateEditDialog();
    }

    /// <summary>
    /// Show alert dialog
    /// </summary>
    /// <param name="selectedRecords"></param>
    public async Task ShowAlertDialog(List<ExpenseData> selectedRecords)
    {
        this.GridSelectedRecords = selectedRecords;
        bool isConfirm = await DialogService.ConfirmAsync("Are you sure you want to delete the selected transaction(s)?", "Delete", new DialogOptions()
            {
                ShowCloseIcon = true,
                Width = "40%",
                PrimaryButtonOptions = new DialogButtonOptions() { Content = "Yes" },
                CancelButtonOptions = new DialogButtonOptions() { Content = "No" },
            });
        if(isConfirm){
            await this.OnClickDelete();
            ContentRef.Toolbaritems[0].Disabled = true;
            ContentRef.Toolbaritems[1].Disabled = true;
            ShowDeleteMsg = true;
            StateHasChanged();
        }
    }

    public async Task DlgOverlayClicked()
    {
        if (CreateNewDialog && this.TransactionDialog != null)
            await this.TransactionDialog.HideAsync();
    }

    public void DlgTransactTypeChanged(Syncfusion.Blazor.Buttons.ChangeArgs<string> args)
    {
        if (args.Value == "Income")
        {
            this.CategoryDataSource = this.ExpenseDataService.CategoryIncomeData ?? new List<CategoryData>();
        }
        else
        {
            this.CategoryDataSource = this.ExpenseDataService.CategoryExpenseData ?? new List<CategoryData>();
        }
        this.CategoryValue = this.CategoryDataSource.Count > 0 ? this.CategoryDataSource[0].Category : "";
    }

    /// <summary>
    /// Add or edit grid data
    /// </summary>
    /// <param name="args"></param>
    public async Task OnClickSave()
    {
        try
        {
            // Validate ExpenseDataService
            if (ExpenseDataService == null)
            {
                await DialogService.AlertAsync("Data service not initialized. Please reload the page.", "Error");
                return;
            }

            // Validate required fields
            if (string.IsNullOrWhiteSpace(this.CategoryValue))
            {
                await DialogService.AlertAsync("Please select a category", "Validation Error");
                return;
            }

            if (this.Amount == null || this.Amount <= 0)
            {
                await DialogService.AlertAsync("Please enter a valid amount", "Validation Error");
                return;
            }

            if (this.ContentRef == null)
            {
                await DialogService.AlertAsync("Grid reference not initialized. Please try again.", "Error");
                return;
            }

            var expenseData = new ExpenseData
            {
                UniqueId = string.IsNullOrEmpty(this.UniqueId) ? Guid.NewGuid().ToString() : this.UniqueId,
                TransactionType = this.TransactionType ?? "Expense",
                Category = this.CategoryValue,
                PaymentMode = this.PaymentMode ?? "Cash",
                Description = this.Description ?? "",
                Amount = (int)(this.Amount ?? 0),
                MonthShort = DateTime.Now.ToString("MMM"),
                MonthFull = DateTime.Now.ToString("MMMM, yyyy"),
                FormattedDate = DateTime.Now.ToString("MM/dd/yyyy hh:mm tt")
            };

            // Calculate DateTime safely
            try
            {
                var date = this.DateValue ?? ExpenseDataService.EndDate;
                var time = this.TimeValue ?? ExpenseDataService.EndDate;
                expenseData.DateTime = date.Date.Add(time.TimeOfDay);
            }
            catch
            {
                expenseData.DateTime = ExpenseDataService.EndDate;
            }

            // Update formatted date with actual datetime
            expenseData.MonthShort = expenseData.DateTime.ToString("MMM");
            expenseData.MonthFull = expenseData.DateTime.ToString("MMMM, yyyy");
            expenseData.FormattedDate = expenseData.DateTime.ToString("MM/dd/yyyy hh:mm tt");
            
            if (IsAdd)
            {
                this.ContentRef.AddRecord(expenseData);
                ShowAddedMsg = true;
            }
            else
            {
                this.ContentRef.UpdateRecord(expenseData);
                ShowSavedMsg = true;
            }
            
            if (this.TransactionDialog != null)
                await this.TransactionDialog.HideAsync();
            this.ContentRef.UpdateTotalBalance();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in OnClickSave: {ex.Message}");
            Console.WriteLine($"Stack Trace: {ex.StackTrace}");
            await DialogService.AlertAsync($"Error: {ex.Message}", "Error");
        }
    }

    /// <summary>
    /// Delete record from grid
    /// </summary>
    /// <param name="args"></param>
    public async Task OnClickDelete()
    {
        var selectedIds = this.GridSelectedRecords.Select(s => s.UniqueId).Where(id => id != null).Select(id => id!).ToList();
        this.ContentRef.RemoveRecord(selectedIds);
        this.ContentRef.UpdateTotalBalance();
        await ContentRef.EnableToolbarItems();
    }

    public async Task OnClickCancel()
    {
        await this.DlgOverlayClicked();
    }

    protected override async void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        
        // Show dialog if it was just created
        if (ShouldShowDialog && TransactionDialog != null)
        {
            ShouldShowDialog = false;
            try
            {
                await TransactionDialog.ShowAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error showing dialog: {ex}");
            }
        }
        
        // Hide success messages after delay
        if(ShowDeleteMsg || ShowAddedMsg || ShowSavedMsg){
            await Task.Delay(1000);
            ShowDeleteMsg = false;
            ShowAddedMsg = false;
            ShowSavedMsg = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        TransactionDialog = null;
        DropDownList = null;
    }
}